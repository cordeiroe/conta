# Firebase client SDK (V2 - quando ativar FCM push)
# Esses valores são PÚBLICOS por design do Firebase — segurança fica nas rules.
# Copie este arquivo para .env e preencha com os valores do seu projeto Firebase.
# .env está no .gitignore e NUNCA é commitado.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=conta-f0c65
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
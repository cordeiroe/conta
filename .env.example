# Worker URL (Cloudflare Workers — single-level subdomain of cordeiroe.dev
# so it shares the zone's Universal SSL cert and CF Access cookies are sent)
VITE_WORKER_URL=https://api-conta.cordeiroe.dev

# Dev bypass: email to impersonate when VITE_WORKER_URL is the production worker
# Only used in dev mode (import.meta.env.DEV)
VITE_DEV_USER=cordeiroe@gmail.com

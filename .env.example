# Worker URL (optional — defaults to same-origin /api/* in production)
# In production, leave empty: the Pages Function proxies /api/* to the
# Worker, keeping CF Access cookies on the same origin (conta.cordeiroe.dev).
# In dev (vite dev server at localhost:5173), set to the worker URL directly:
VITE_WORKER_URL=
# VITE_WORKER_URL=http://127.0.0.1:8787

# Dev bypass: email to impersonate when VITE_WORKER_URL is the dev worker.
# Only used in dev mode (import.meta.env.DEV).
VITE_DEV_USER=cordeiroe@gmail.com
